# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=replace-with-random-64-byte-string-in-production
JWT_EXPIRES_IN=30d

# Database
DATABASE_PATH=./data/cryptota.db

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8092,http://localhost:3000

# NOWPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Sandbox mode for testing (set to "true" to use https://api-sandbox.nowpayments.io)
NOWPAYMENTS_SANDBOX=true

# Public base URL of this server (used in NOWPayments callbacks)
PUBLIC_BASE_URL=http://localhost:3001

# CryptoTA frontend origin (used for CORS + email links)
FRONTEND_URL=http://localhost:8092
