# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=replace-with-random-64-byte-string-in-production
JWT_EXPIRES_IN=30d

# Database
DATABASE_PATH=./data/cryptota.db

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8092,http://localhost:3000

# TON (Toncoin) direct payments — single static wallet, users include a memo.
# Get a wallet address from https://tonkeeper.com or any TON wallet app.
TON_ADDRESS=

# Public base URL of this server (used in share links, etc.)
PUBLIC_BASE_URL=http://localhost:3001

# CryptoTA frontend origin (used for CORS + email links)
FRONTEND_URL=http://localhost:8092
